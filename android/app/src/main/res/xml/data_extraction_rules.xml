<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone through Android's cloud backup or a phone-to-phone transfer: the pairing cookie and
     everything else stay put. Settings > Export setup is the way to move a setup (PLAN-PRODUCTION.md P0 12). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
