{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Agentic OS",
  "version": "0.1.0",
  "identifier": "com.agenticos.desktop",
  "build": {
    "frontendDist": "../fallback"
  },
  "app": {
    "windows": [
      {
        "title": "Agentic OS",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
